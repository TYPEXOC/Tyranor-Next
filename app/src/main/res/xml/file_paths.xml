<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 应用内更新下载的 APK 存放目录：优先 getExternalFilesDir/updates，外置存储不可用时回退 filesDir/updates -->
    <external-files-path
        name="update_apks"
        path="updates/" />
    <files-path
        name="update_apks_internal"
        path="updates/" />
    <!-- RGSS runtime modules receive temporary access to the selected translation and input profile. -->
    <external-files-path
        name="translation_tables"
        path="translations/" />
    <files-path
        name="input_profiles"
        path="input/profiles/" />
    <!-- 外置模拟器跳转：File 回退路径（无法走 SAF 的真实路径 ROM）转 content URI 共享 -->
    <external-path
        name="external_roms"
        path="." />
    <root-path
        name="root_roms"
        path="/" />
</paths>
